<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Zarcovi RPG Banco</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <main class="app">
    <section class="hero">
      <div class="badge">Zarcovi RPG</div>
      <h1>Zarcovi RPG Banco</h1>
      <p>Banco oficial de consulta de contas, ryos, level, vila, cargos e dados do RPG.</p>

      <div class="actions">
        <button onclick="showPanel('login')">Entrar</button>
        <button class="secondary" onclick="showPanel('register')">Criar conta</button>
        <button class="ghost" onclick="showPanel('staff')">Painel Staff</button>
      </div>
    </section>

    <section class="grid">
      <article class="card" id="login">
        <h2>Login</h2>
        <input id="loginEmail" placeholder="Email" />
        <input id="loginPassword" type="password" placeholder="Senha do app" />
        <button onclick="fakeMessage('Login pronto para ligar ao Supabase Auth.')">Entrar</button>
        <small>Nunca use a senha real da sua conta Zarcovi.</small>
      </article>

      <article class="card hidden" id="register">
        <h2>Cadastro</h2>
        <input id="regAccount" placeholder="Conta Zarcovi, exemplo: MY9314" />
        <input id="regName" placeholder="Nome no RPG" />
        <input id="regEmail" placeholder="Email" />
        <input id="regPassword" type="password" placeholder="Senha do app" />
        <button onclick="fakeMessage('Cadastro pronto para validar a conta no Supabase.')">Criar login</button>
        <small>A senha é só do app. Não use a senha real da conta Zarcovi.</small>
      </article>

      <article class="card hidden" id="staff">
        <h2>Painel Staff</h2>
        <input id="adminToken" placeholder="ADMIN_TOKEN" />
        <input id="searchAccount" placeholder="Buscar conta, exemplo: MY9314" />
        <button onclick="fakeMessage('Busca pronta para usar /api/account/search.')">Buscar conta</button>
        <button class="secondary" onclick="fakeMessage('Sync pronto para usar /api/sync.')">Sincronizar planilha</button>
      </article>

      <article class="card status">
        <h2>Status do Projeto</h2>
        <ul>
          <li>Supabase PostgreSQL</li>
          <li>Cloudflare Pages</li>
          <li>GitHub Deploy</li>
          <li>Google Planilhas como fonte</li>
        </ul>
      </article>
    </section>

    <section class="result" id="result">
      Sistema carregado. Se você está vendo esta tela, o Hello World foi removido.
    </section>
  </main>

  <script src="/app.js"></script>
</body>
</html>
